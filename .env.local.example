# OpenRouter powers sentence analysis and image text extraction.
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Header overwritten by the production reverse proxy with the client IP.
# The proxy must replace, not append to, any client-supplied value.
RATE_LIMIT_IP_HEADER=x-forwarded-for

# Dev-only admin seed (created automatically when NODE_ENV=development)
# Defaults: admin@localhost.dev / dev-admin-password
# DEV_ADMIN_EMAIL=admin@localhost.dev
# DEV_ADMIN_PASSWORD=dev-admin-password
# DEV_ADMIN_NAME=Dev Admin
